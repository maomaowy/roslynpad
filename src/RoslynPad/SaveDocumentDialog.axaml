<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RoslynPad;assembly=RoslynPad"
             x:Class="RoslynPad.SaveDocumentDialog"
             x:DataType="local:SaveDocumentDialog"
             MinWidth="360">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Title}"
                   Classes="dialogTitle" />
        <TextBlock Text="{DynamicResource L_Dialog_DocumentName}"
                   Classes="fieldLabel" />
        <TextBox Name="DocumentTextBox"
                 Classes="field"
                 KeyDown="DocumentText_KeyDown"
                 Text="{Binding DocumentName}"
                 IsEnabled="{Binding AllowNameEdit}"
                 MaxLength="200" />
        <StackPanel HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,20,0,0">
            <Button Name="OverwriteButton"
                    Classes="danger"
                    IsVisible="false"
                    Content="{DynamicResource L_Dialog_OverwriteButton}"
                    Click="Overwrite_Click"/>
            <Button Classes="secondary"
                    Content="{DynamicResource L_Dialog_DontSaveButton}"
                    IsVisible="{Binding ShowDoNotSave}"
                    Name="DontSaveButton"
                    Click="DoNotSave_Click" />
            <Button Classes="secondary"
                    Content="{DynamicResource L_Dialog_CancelButton}"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button Classes="primary"
                    IsDefault="True"
                    Name="SaveButton"
                    Content="{DynamicResource L_Dialog_SaveButton}"
                    Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>