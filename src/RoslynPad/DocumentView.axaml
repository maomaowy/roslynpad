<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RoslynPad.DocumentView"
             xmlns:local="clr-namespace:RoslynPad;assembly=RoslynPad"
             xmlns:build="clr-namespace:RoslynPad.Build"
             xmlns:ui="clr-namespace:RoslynPad.UI"
             xmlns:converters="clr-namespace:RoslynPad.Converters"
             x:DataType="ui:OpenDocumentViewModel">
  <UserControl.Resources>
    <converters:DoubleToPercentageTextConverter x:Key="DoubleToPercentageTextConverter" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Padding="6 3"
            BorderThickness="0 0 0 1"
            BorderBrush="{DynamicResource {x:Static local:ThemeDictionary.PanelBorder}}">
      <StackPanel Name="Toolbar"
                  Orientation="Horizontal"
                  Spacing="2">
        <Button Classes="tool"
                Command="{Binding RunCommand, Mode=OneTime}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_Run}"
                ToolTip.Tip="{DynamicResource L_Tooltip_Run}">
          <Grid>
            <Image Source="{StaticResource Run}" />
            <ProgressBar VerticalAlignment="Bottom"
                         Height="3"
                         MinWidth="0"
                         IsIndeterminate="{Binding IsRunning}"
                         BorderThickness="0"
                         IsVisible="{Binding IsRunning}" />
          </Grid>
        </Button>
        <ToggleButton Classes="tool"
                      Command="{Binding ToggleLiveModeCommand, Mode=OneTime}"
                      IsChecked="{Binding IsLiveMode, Mode=OneWay}"
                      AutomationProperties.Name="{DynamicResource L_Automation_LiveMode}"
                      ToolTip.Tip="{DynamicResource L_Tooltip_ToggleLiveMode}">
          <Image Source="{StaticResource Rocket}" />
        </ToggleButton>
        <Button Classes="tool"
                Command="{Binding TerminateCommand, Mode=OneTime}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_Terminate}"
                ToolTip.Tip="{OnPlatform Default={DynamicResource L_Tooltip_Terminate}, macOS={DynamicResource L_Tooltip_TerminateMac}}"
                IsEnabled="{Binding IsRunning}">
          <Image Source="{StaticResource Stop}" />
        </Button>
        <Grid Width="90"
              Margin="4 0"
              VerticalAlignment="Center"
              IsVisible="{Binding HasReportedProgress}">
          <ProgressBar Value="{Binding ReportedProgress, Mode=OneWay}"
                       Minimum="0.0"
                       Maximum="1.0" />
          <TextBlock Text="{Binding ReportedProgress, Mode=OneWay, Converter={StaticResource DoubleToPercentageTextConverter}}"
                     FontSize="11"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Grid>
        <ComboBox ItemsSource="{Binding AvailablePlatforms, Mode=OneTime}"
                  SelectedItem="{Binding Platform}"
                  Classes="field"
                  Height="28"
                  MinWidth="140"
                  FontSize="13"
                  Padding="8 3"
                  VerticalAlignment="Center"
                  VerticalContentAlignment="Center"
                  AutomationProperties.Name="{DynamicResource L_Tooltip_TargetPlatform}"
                  ToolTip.Tip="{DynamicResource L_Tooltip_TargetPlatform}" />
        <Button Classes="tool"
                AutomationProperties.Name="{DynamicResource L_Tooltip_SetDefaultPlatform}"
                ToolTip.Tip="{DynamicResource L_Tooltip_SetDefaultPlatform}"
                Command="{Binding SetDefaultPlatformCommand, Mode=OneTime}">
          <Image Source="{StaticResource SetPlatform}" />
        </Button>
        <Separator Classes="toolbar" />
        <Button Classes="tool"
                Command="{Binding SaveCommand, Mode=OneTime}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_Save}"
                ToolTip.Tip="{OnPlatform Default={DynamicResource L_Tooltip_Save}, macOS={DynamicResource L_Tooltip_SaveMac}}">
          <Image Source="{StaticResource Save}" />
        </Button>
        <Button Classes="tool"
                Command="{Binding MainViewModel.NewDocumentCommand, Mode=OneTime}"
                CommandParameter="{Binding SourceCodeKind}"
                AutomationProperties.Name="{DynamicResource L_Automation_NewDocument}"
                ToolTip.Tip="{DynamicResource L_Tooltip_NewDocument}">
          <Image Source="{Binding Converter={x:Static local:DocumentIconConverter.Instance}}" />
        </Button>
        <Button Classes="tool"
                Command="{Binding OpenBuildPathCommand, Mode=OneTime}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_OpenBuildFolder}"
                ToolTip.Tip="{DynamicResource L_Tooltip_OpenBuildFolder}">
          <Image Source="{StaticResource PackageFolder}" />
        </Button>
        <ToggleButton Classes="tool"
                      IsChecked="{Binding MainViewModel.EnableInlineDiagnostics}"
                      AutomationProperties.Name="{DynamicResource L_Tooltip_InlineDiagnostics}"
                      ToolTip.Tip="{DynamicResource L_Tooltip_InlineDiagnostics}">
          <Image Source="{StaticResource InlineDiagnostics}" />
        </ToggleButton>
        <Separator Classes="toolbar" />
        <Menu Background="Transparent"
              Name="RootMenu"
              AutomationProperties.Name="{DynamicResource L_Tooltip_NuGetPackages}"
              VerticalAlignment="Center">
          <MenuItem Name="RootNuGetMenu"
                    Padding="5"
                    IsSubMenuOpen="{Binding NuGet.IsPackagesMenuOpen}"
                    ItemsSource="{Binding NuGet.Packages}"
                    Header="{Binding NuGet, Mode=OneTime}"
                    ToolTip.Tip="{DynamicResource L_Tooltip_NuGetPackages}">
            <MenuItem.Styles>
              <Style Selector="MenuItem Popup">
                <Setter Property="MaxHeight" Value="400" />
              </Style>
              <Style Selector="MenuItem > MenuItem"
                     x:DataType="ui:PackageData">
                <Setter Property="Command"
                        Value="{Binding InstallPackageCommand}" />
                <Setter Property="CommandParameter"
                        Value="{Binding}" />
              </Style>
            </MenuItem.Styles>
            <MenuItem.DataTemplates>
              <DataTemplate DataType="ui:PackageData">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                  <TextBlock Text="{Binding Id, Mode=OneTime}" />
                  <TextBlock Text="{Binding Version, Mode=OneTime}"
                             Foreground="{DynamicResource {x:Static local:ThemeDictionary.DescriptionForeground}}" />
                </StackPanel>
              </DataTemplate>
              <DataTemplate DataType="ui:NuGetDocumentViewModel">
                <Grid>
                  <Image Source="{StaticResource NuGet}"
                         Width="16"
                         Height="16" />
                  <ProgressBar VerticalAlignment="Bottom"
                               Height="3"
                               MinWidth="0"
                               BorderThickness="0"
                               IsIndeterminate="{Binding IsSearching}"
                               IsVisible="{Binding IsSearching}" />
                </Grid>
              </DataTemplate>
            </MenuItem.DataTemplates>
          </MenuItem>
        </Menu>
        <TextBox Name="NuGetSearch"
                 Classes="field"
                 AutomationProperties.Name="{DynamicResource L_Placeholder_SearchNuGet}"
                 Text="{Binding NuGet.SearchTerm}"
                 PlaceholderText="{OnPlatform Default={DynamicResource L_Placeholder_SearchNuGet}, macOS={DynamicResource L_Placeholder_SearchNuGetMac}}"
                 Width="220"
                 MinHeight="28"
                 FontSize="13"
                 Padding="8 3"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center" />
        <CheckBox IsChecked="{Binding NuGet.Prerelease}"
                  ToolTip.Tip="{DynamicResource L_Tooltip_IncludePrerelease}"
                  Content="{DynamicResource L_Doc_Prerelease}"
                  MinHeight="0"
                  FontSize="13"
                  Margin="4 0 0 0"
                  VerticalAlignment="Center" />
        <Separator Classes="toolbar" />
        <Button Classes="tool"
                AutomationProperties.Name="{DynamicResource L_Tooltip_FormatDocument}"
                ToolTip.Tip="{OnPlatform Default={DynamicResource L_Tooltip_FormatDocument}, macOS={DynamicResource L_Tooltip_FormatDocumentMac}}"
                Command="{Binding FormatDocumentCommand, Mode=OneTime}">
          <Image Source="{StaticResource FormatDocument}" />
        </Button>
        <Button Classes="tool"
                AutomationProperties.Name="{DynamicResource L_Tooltip_CommentSelection}"
                ToolTip.Tip="{OnPlatform Default={DynamicResource L_Tooltip_CommentSelection}, macOS={DynamicResource L_Tooltip_CommentSelectionMac}}"
                Command="{Binding CommentSelectionCommand, Mode=OneTime}">
          <Image Source="{StaticResource CommentCode}" />
        </Button>
        <Button Classes="tool"
                AutomationProperties.Name="{DynamicResource L_Tooltip_UncommentSelection}"
                ToolTip.Tip="{OnPlatform Default={DynamicResource L_Tooltip_UncommentSelection}, macOS={DynamicResource L_Tooltip_UncommentSelectionMac}}"
                Command="{Binding UncommentSelectionCommand, Mode=OneTime}">
          <Image Source="{StaticResource UncommentCode}" />
        </Button>
        <Button Classes="tool"
                AutomationProperties.Name="{DynamicResource L_Tooltip_RenameSymbol}"
                ToolTip.Tip="{DynamicResource L_Tooltip_RenameSymbol}"
                Command="{Binding RenameSymbolCommand, Mode=OneTime}">
          <Image Source="{StaticResource Rename}" />
        </Button>
      </StackPanel>
    </Border>

    <local:CodeEditorView Name="Editor"
                          Grid.Row="1" />
  </Grid>
</UserControl>
