<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RoslynPad.MainWindow"
        xmlns:local="clr-namespace:RoslynPad;assembly=RoslynPad"
        xmlns:roslyn="clr-namespace:Microsoft.CodeAnalysis;assembly=Microsoft.CodeAnalysis"
        xmlns:ui="clr-namespace:RoslynPad.UI"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        MinWidth="500"
        MinHeight="300"
        x:DataType="ui:MainViewModel"
        Title="{Binding WindowTitle, Mode=OneTime}"
        Icon="avares://RoslynPad/Resources/RoslynPad.ico"
        Name="This">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="L_Menu_File">
        <NativeMenu>
          <NativeMenuItem Header="L_Menu_NewFileApp" Gesture="Meta+N"
                          Click="OnNewDocumentClick" />
          <NativeMenuItem Header="L_Menu_NewScript" Gesture="Meta+Shift+N"
                          Click="OnNewScriptClick" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="L_Menu_Open" Gesture="Meta+O"
                          Command="{Binding OpenFileCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="L_Menu_Save" Gesture="Meta+S"
                          Click="OnSaveClick" />
          <NativeMenuItem Header="L_Menu_Close" Gesture="Meta+W"
                          Command="{Binding CloseCurrentDocumentCommand}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="L_Menu_Edit">
        <NativeMenu>
          <NativeMenuItem Header="L_Menu_Find" Gesture="Meta+F"
                          Click="OnFindClick" />
          <NativeMenuItem Header="L_Menu_Replace" Gesture="Meta+Alt+F"
                          Click="OnReplaceClick" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="L_Menu_FormatDocument" Gesture="Meta+D"
                          Click="OnFormatDocumentClick" />
          <NativeMenuItem Header="L_Menu_CommentSelection" Gesture="Meta+K"
                          Click="OnCommentSelectionClick" />
          <NativeMenuItem Header="L_Menu_UncommentSelection" Gesture="Meta+U"
                          Click="OnUncommentSelectionClick" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="L_Menu_RenameSymbol" Gesture="F2"
                          Click="OnRenameSymbolClick" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="L_Menu_Run">
        <NativeMenu>
          <NativeMenuItem Header="L_Menu_Run" Gesture="F5"
                          Click="OnRunClick" />
          <NativeMenuItem Header="L_Menu_Terminate" Gesture="Shift+F5"
                          Click="OnTerminateClick" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="L_Menu_ToggleLiveMode"
                          Click="OnToggleLiveModeClick" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>
  <dialogHost:DialogHost x:Name="DiaglogHost" Identifier="Main" CloseOnClickAway="True" DisableOpeningAnimation="True"
                         OverlayBackground="Transparent"
                         Background="{DynamicResource {x:Static local:ThemeDictionary.EditorBackground}}"
                         dialogHost:DialogHostStyle.CornerRadius="10"
                         dialogHost:DialogHostStyle.BorderThickness="1"
                         dialogHost:DialogHostStyle.BorderBrush="{DynamicResource {x:Static local:ThemeDictionary.EditorGroupBorder}}"
                         dialogHost:DialogHostStyle.BoxShadow="0 20 60 #66000000">
    <DockPanel Background="{DynamicResource DockSurfaceWorkbenchBrush}">

      <Button Name="ErrorBar"
              DockPanel.Dock="Bottom"
              Padding="10 6"
              CornerRadius="0"
              BorderThickness="0"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              Background="{DynamicResource {x:Static local:ThemeDictionary.StatusBarItemErrorBackground}}"
              Foreground="{DynamicResource {x:Static local:ThemeDictionary.StatusBarItemErrorForeground}}"
              Click="OnErrorButtonClick"
              ToolTip.Tip="{DynamicResource L_Status_ShowErrorDetails}"
              IsVisible="{Binding HasError}">
        <Button.Styles>
          <Style Selector="Button#ErrorBar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static local:ThemeDictionary.StatusBarItemErrorBackground}}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static local:ThemeDictionary.StatusBarItemErrorForeground}}" />
          </Style>
          <Style Selector="Button#ErrorBar:pointerover">
            <Setter Property="Opacity" Value="0.9" />
          </Style>
        </Button.Styles>
        <StackPanel Orientation="Horizontal"
                    Spacing="6">
          <Image Source="{StaticResource ExceptionMarker}"
                 Width="14"
                 Height="14" />
          <TextBlock VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding LastError.Message}" />
        </StackPanel>
      </Button>

      <Border DockPanel.Dock="Bottom"
              Padding="10 3"
              MinHeight="24"
              Background="{DynamicResource {x:Static local:ThemeDictionary.StatusBarBackground}}"
              BorderBrush="{DynamicResource {x:Static local:ThemeDictionary.PanelBorder}}"
              BorderThickness="0 1 0 0">
        <DockPanel LastChildFill="False">

          <TextBlock DockPanel.Dock="Left"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{DynamicResource {x:Static local:ThemeDictionary.StatusBarForeground}}"
                     IsVisible="{Binding CurrentOpenDocument, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding CurrentOpenDocument.CaretPositionText, Mode=OneWay}" />

          <StackPanel DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center"
                      TextBlock.Foreground="{DynamicResource {x:Static local:ThemeDictionary.StatusBarForeground}}">

            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        IsVisible="{Binding CurrentOpenDocument.IsRestoring, FallbackValue=False}">
              <ProgressBar Width="64"
                           Height="3"
                           IsIndeterminate="True"
                           VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource L_Status_Restoring}"
                         FontSize="12"
                         VerticalAlignment="Center" />
            </StackPanel>

            <ToggleButton Classes="tool"
                          Width="22"
                          Height="22"
                          IsChecked="{Binding Settings.OptimizeCompilation}"
                          AutomationProperties.Name="{DynamicResource L_Tooltip_Optimization}"
                          ToolTip.Tip="{OnPlatform Default={DynamicResource L_Tooltip_Optimization}, macOS={DynamicResource L_Tooltip_OptimizationMac}}">
              <Image Source="{StaticResource Time}"
                     Width="14"
                     Height="14" />
            </ToggleButton>

            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
              <Image Source="{StaticResource FontSize}"
                     Height="14"
                     Width="14"
                     VerticalAlignment="Center" />
              <Slider Width="110"
                      AutomationProperties.Name="{DynamicResource L_Tooltip_EditorFontSize}"
                      ToolTip.Tip="{DynamicResource L_Tooltip_EditorFontSize}"
                      VerticalAlignment="Center"
                      Minimum="{x:Static ui:MainViewModel.MinimumFontSize}"
                      Maximum="{x:Static ui:MainViewModel.MaximumFontSize}"
                      SmallChange="1"
                      LargeChange="10"
                      IsSnapToTickEnabled="True"
                      TickFrequency="1"
                      Value="{Binding EditorFontSize}">
                <Slider.Resources>
                  <x:Double x:Key="SliderHorizontalHeight">22</x:Double>
                  <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
                  <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
                </Slider.Resources>
              </Slider>
              <TextBlock Text="{Binding EditorFontSize}"
                         MinWidth="16"
                         VerticalAlignment="Center"
                         FontSize="12" />
            </StackPanel>

          </StackPanel>
        </DockPanel>
      </Border>

      <DockControl x:Name="Dock" Margin="8,4,8,8" InitializeLayout="True" InitializeFactory="True">
        <DockControl.Factory>
          <Factory ActiveDockableChanged="OnActiveDockableChanged"
                   DockableClosing="OnDockableClosingAsync" />
        </DockControl.Factory>

        <RootDock x:Name="Root" Id="Root" IsCollapsable="False" DefaultDockable="{Binding #MainLayout}">

          <ProportionalDock x:Name="MainLayout" Id="MainLayout" Orientation="Horizontal">

            <ToolDock x:Name="LeftPane" Id="LeftPane" Proportion="0.25" Alignment="Left">
              <Tool x:Name="Documents" Id="Documents" Title="{DynamicResource L_Pane_Documents}" x:DataType="Tool" CanFloat="False" CanPin="True" CanClose="False">
                <local:DocumentTreeView x:Name="DocumentTreeView" DataContext="{Binding #This.DataContext}" />
              </Tool>
            </ToolDock>

            <ProportionalDockSplitter x:Name="LeftSplitter" Id="LeftSplitter" />

            <ProportionalDock x:Name="MainPane" Id="MainPane" Orientation="Vertical">

              <DocumentDock x:Name="DocumentsPane" Id="DocumentsPane" IsCollapsable="False" />

               <ProportionalDockSplitter x:Name="ResultSplitter" Id="ResultSplitter" />


                <!-- A DocumentDock styled as VS Code panel pills: tabs on top, no chrome title bar.
                     The tabs are fixed: not closable, floatable, or draggable into the documents pane. -->
                <DocumentDock x:Name="ResultPane" Id="ResultPane" Proportion="0.35" IsCollapsable="False" CanDrop="False">
                  <Document x:Name="Results" Id="Results" Title="{DynamicResource L_Pane_Results}" x:DataType="Document" CanFloat="False" CanPin="False" CanClose="False" CanDrag="False">
                      <local:ResultsView x:Name="ResultsView" DataContext="{Binding #This.ViewModel.CurrentOpenDocument}" />
                  </Document>
                  <Document x:Name="Build" Id="Build" Title="{DynamicResource L_Pane_Output}" x:DataType="Document" CanFloat="False" CanPin="False" CanClose="False" CanDrag="False">
                      <local:PaneHeader.Content>
                        <ComboBox ItemsSource="{Binding #This.ViewModel.CurrentOpenDocument.BuildOutput.Documents}"
                                  SelectedItem="{Binding #This.ViewModel.CurrentOpenDocument.BuildOutput.SelectedDocument, Mode=TwoWay}"
                                  MinHeight="24"
                                  FontSize="12"
                                  Padding="8 2"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  ToolTip.Tip="{DynamicResource L_Tooltip_BuildOutputSource}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="ui:BuildOutputDocument">
                              <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </local:PaneHeader.Content>
                      <local:BuildOutputView x:Name="BuildOutputView" DataContext="{Binding #This.ViewModel.CurrentOpenDocument}"
                                             ViewModel="{Binding #This.ViewModel}" />
                  </Document>
                  <Document x:Name="IL" Id="IL" Title="{DynamicResource L_Pane_IL}" x:DataType="Document" CanFloat="False" CanPin="False" CanClose="False" CanDrag="False">
                      <local:ILViewer x:Name="ILViewer" Text="{Binding #This.ViewModel.CurrentOpenDocument.ILText}"
                                      ViewModel="{Binding #This.ViewModel}" />
                  </Document>
              </DocumentDock>

            </ProportionalDock>

          </ProportionalDock>
        </RootDock>

      </DockControl>

    </DockPanel>
  </dialogHost:DialogHost>

</Window>
