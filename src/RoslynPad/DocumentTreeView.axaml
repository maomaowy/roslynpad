<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:roslynPad="using:RoslynPad"
             xmlns:roslyn="clr-namespace:Microsoft.CodeAnalysis;assembly=Microsoft.CodeAnalysis"
             xmlns:ui="using:RoslynPad.UI"
             x:Class="RoslynPad.DocumentTreeView"
             x:DataType="ui:MainViewModel"
             Background="{DynamicResource {x:Static roslynPad:ThemeDictionary.SideBarBackground}}">
  <UserControl.Resources>
    <x:Double x:Key="TreeViewItemMinHeight">26</x:Double>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*">

    <Border Grid.Row="0"
            Padding="6 3"
            BorderThickness="0 0 0 1"
            BorderBrush="{DynamicResource {x:Static roslynPad:ThemeDictionary.PanelBorder}}">
      <StackPanel Orientation="Horizontal"
                  Spacing="2">
        <Button Classes="tool"
                Command="{Binding NewDocumentCommand, Mode=OneTime}"
                CommandParameter="{x:Static roslyn:SourceCodeKind.Regular}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_NewFileApp}"
                ToolTip.Tip="{OnPlatform Default={DynamicResource L_Tooltip_NewFileApp}, macOS={DynamicResource L_Tooltip_NewFileAppMac}}">
          <Image Source="{StaticResource CsFile}" />
        </Button>
        <Button Classes="tool"
                Command="{Binding NewDocumentCommand, Mode=OneTime}"
                CommandParameter="{x:Static roslyn:SourceCodeKind.Script}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_NewScript}"
                ToolTip.Tip="{OnPlatform Default={DynamicResource L_Tooltip_NewScript}, macOS={DynamicResource L_Tooltip_NewScriptMac}}">
          <Image Source="{StaticResource Script}" />
        </Button>
        <Button Classes="tool"
                Command="{Binding OpenFileCommand, Mode=OneTime}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_OpenFile}"
                ToolTip.Tip="{OnPlatform Default={DynamicResource L_Tooltip_OpenFile}, macOS={DynamicResource L_Tooltip_OpenFileMac}}">
          <Image Source="{StaticResource OpenFolder}" />
        </Button>
        <Button Classes="tool"
                Command="{Binding EditUserDocumentPathCommand, Mode=OneTime}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_ChangeDocumentsLocation}"
                ToolTip.Tip="{DynamicResource L_Tooltip_ChangeDocumentsLocation}">
          <Image Source="{DynamicResource MoveFolder}" />
        </Button>
        <Separator Classes="toolbar" />
        <Button Classes="tool"
                Command="{Binding ClearRestoreCacheCommand, Mode=OneTime}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_ClearRestoreCache}"
                ToolTip.Tip="{DynamicResource L_Tooltip_ClearRestoreCache}">
          <Image Source="{DynamicResource ClearContent}" />
        </Button>
        <Button Classes="tool"
                Command="{Binding OpenSettingsCommand, Mode=OneTime}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_Settings}"
                ToolTip.Tip="{DynamicResource L_Tooltip_Settings}">
          <Image Source="{DynamicResource Settings}" />
        </Button>
        <Button Classes="tool"
                Command="{Binding OpenSecretsCommand, Mode=OneTime}"
                AutomationProperties.Name="{DynamicResource L_Tooltip_Secrets}"
                ToolTip.Tip="{DynamicResource L_Tooltip_Secrets}">
          <Image Source="{DynamicResource Secrets}" />
        </Button>
      </StackPanel>
    </Border>

    <TextBox Grid.Row="1"
             Name="SearchText"
             Classes="field"
             Margin="6 6 6 4"
             MinHeight="28"
             FontSize="13"
             Padding="8 3"
             VerticalContentAlignment="Center"
             PlaceholderText="{DynamicResource L_Tree_SearchPlaceholder}"
             Text="{Binding SearchText}">
      <TextBox.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
      </TextBox.KeyBindings>
      <TextBox.InnerRightContent>
        <StackPanel Orientation="Horizontal"
                    Spacing="1"
                    Margin="0 0 3 0"
                    VerticalAlignment="Center">
          <Button Classes="tool"
                  Width="20"
                  Height="20"
                  Command="{Binding ClearSearchCommand}"
                  AutomationProperties.Name="{DynamicResource L_Tooltip_ClearSearch}"
                  ToolTip.Tip="{DynamicResource L_Tooltip_ClearSearch}"
                  IsVisible="{Binding CanClearSearch}">
            <Image Source="{StaticResource Close}"
                   Width="12"
                   Height="12" />
          </Button>
          <ToggleButton Classes="tool"
                        Width="20"
                        Height="20"
                        IsChecked="{Binding SearchFileContents}"
                        AutomationProperties.Name="{DynamicResource L_Tooltip_SearchFileContents}"
                        ToolTip.Tip="{DynamicResource L_Tooltip_SearchFileContents}">
            <Image Source="{StaticResource FileCollection}"
                   Width="14"
                   Height="14" />
          </ToggleButton>
          <ToggleButton Classes="tool"
                        Width="20"
                        Height="20"
                        IsChecked="{Binding SearchUsingRegex}"
                        AutomationProperties.Name="{DynamicResource L_Tooltip_UseRegex}"
                        ToolTip.Tip="{DynamicResource L_Tooltip_UseRegex}">
            <Image Source="{StaticResource RegularExpression}"
                   Width="14"
                   Height="14" />
          </ToggleButton>
        </StackPanel>
      </TextBox.InnerRightContent>
    </TextBox>

    <TreeView Grid.Row="2"
              ItemsSource="{Binding DocumentRoot.Children}"
              Background="Transparent"
              Margin="0 2 0 0"
              Name="Tree">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="ui:DocumentViewModel">
          <Setter Property="IsVisible" Value="{Binding IsSearchMatch}" />
          <Setter Property="ContextMenu">
            <Setter.Value>
              <ContextMenu>
                <MenuItem Header="{OnPlatform Default={DynamicResource L_Tree_OpenInExplorer}, macOS={DynamicResource L_Tree_OpenInFinder}}"
                          Click="DocumentsContextMenu_OpenFolder_Click" />
                <MenuItem Header="{DynamicResource L_Tree_Rename}"
                          Click="DocumentsContextMenu_Rename_Click" />
                <MenuItem Header="{DynamicResource L_Tree_SaveAs}"
                          Click="DocumentsContextMenu_SaveAs_Click" />
              </ContextMenu>
            </Setter.Value>
          </Setter>
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal"
                      Spacing="6"
                      VerticalAlignment="Center">
            <Image Source="{StaticResource Folder}"
                   Width="16"
                   Height="16"
                   IsVisible="{Binding IsFolder}" />
            <Image Source="{StaticResource CsFile}"
                   Width="16"
                   Height="16"
                   IsVisible="{Binding !IsFolder}" />
            <TextBlock Text="{Binding Name}"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Grid>
</UserControl>
