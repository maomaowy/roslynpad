<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RoslynPad;assembly=RoslynPad"
             x:Class="RoslynPad.RenameDocumentDialog"
             x:DataType="local:RenameDocumentDialog"
             MinWidth="360">
    <StackPanel Margin="16">
        <TextBlock Text="{DynamicResource L_Dialog_RenameTitle}"
                   Classes="dialogTitle" />
        <TextBlock Text="{DynamicResource L_Dialog_DocumentName}"
                   Classes="fieldLabel" />
        <TextBox Name="DocumentTextBox"
                 Classes="field"
                 KeyDown="DocumentText_KeyDown"
                 Text="{Binding DocumentName}"
                 MaxLength="200" />
        <StackPanel HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,20,0,0">
            <Button Classes="secondary"
                    Content="{DynamicResource L_Dialog_CancelButton}"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button Classes="primary"
                    IsDefault="True"
                    Name="RenameButton"
                    Content="{DynamicResource L_Dialog_RenameButton}"
                    Click="Rename_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>