<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:RoslynPad.UI"
             xmlns:local="using:RoslynPad"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="500"
             x:Class="RoslynPad.SettingsView"
             x:DataType="ui:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.SettingName">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.Description">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static local:ThemeDictionary.DescriptionForeground}}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter TextBox -->
        <TextBox x:Name="FilterTextBox"
                 Grid.Row="0"
                 Classes="field"
                 Text="{Binding FilterText}"
                 PlaceholderText="{DynamicResource L_Settings_FilterPlaceholder}"
                 Margin="10,10,10,5" />

        <!-- Settings List -->
        <Panel Grid.Row="1">
            <ScrollViewer Margin="12,4,12,12">
                <ItemsControl ItemsSource="{Binding FilteredSettings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:SettingItem}">
                        <Border BorderBrush="{DynamicResource {x:Static local:ThemeDictionary.PanelBorder}}"
                                BorderThickness="0,0,0,1"
                                Padding="8,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">
                                    <!-- Setting Name -->
                                    <TextBlock Text="{Binding DisplayName}"
                                               Classes="SettingName" />
                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}"
                                               Classes="Description"
                                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <ContentControl Grid.Column="1"
                                                Content="{Binding}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0">
                                    <ContentControl.ContentTemplate>
                                        <local:SettingEditorTemplate />
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Classes="emptyState"
                   Text="{DynamicResource L_Settings_NoMatches}"
                   IsVisible="{Binding !HasFilteredSettings}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="360"
                   IsHitTestVisible="False" />
    </Panel>
    </Grid>
</UserControl>
