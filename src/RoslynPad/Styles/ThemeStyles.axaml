<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rp="clr-namespace:RoslynPad;assembly=RoslynPad">

  <!-- Shared design tokens and control styles for the app-owned surfaces (panes, dialogs,
       settings, secrets). Colors come from the active VS Code theme through ThemeDictionary;
       editor-internal popups are left to the editor's own theming. -->

  <Styles.Resources>
    <x:Double x:Key="AppSpacingXs">4</x:Double>
    <x:Double x:Key="AppSpacingSm">6</x:Double>
    <x:Double x:Key="AppSpacingMd">8</x:Double>
    <x:Double x:Key="AppSpacingLg">12</x:Double>
    <x:Double x:Key="AppSpacingXl">16</x:Double>

    <CornerRadius x:Key="AppCornerSmall">4</CornerRadius>
    <CornerRadius x:Key="AppCornerMedium">6</CornerRadius>
    <CornerRadius x:Key="AppCornerLarge">10</CornerRadius>

    <x:Double x:Key="AppFontSizeCaption">11</x:Double>
    <x:Double x:Key="AppFontSizeSmall">12</x:Double>
    <x:Double x:Key="AppFontSizeBody">13</x:Double>
    <x:Double x:Key="AppFontSizeTitle">16</x:Double>

    <x:Double x:Key="AppListRowHeight">26</x:Double>
    <x:Double x:Key="AppFieldMinHeight">28</x:Double>
    <Thickness x:Key="AppPanelToolbarPadding">6,3</Thickness>
    <Thickness x:Key="AppDialogPadding">16</Thickness>
  </Styles.Resources>

  <!-- Base typography and foreground -->
  <Style Selector="Window">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.Foreground}}" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
  </Style>

  <Style Selector="TextBlock.dialogTitle">
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.DescriptionForeground}}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.PanelTitleActiveForeground}}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.DescriptionForeground}}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.emptyState">
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.DescriptionForeground}}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.errorText">
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ErrorForeground}}" />
  </Style>

  <!-- Inputs: class-scoped so the editor's find/replace and NuGet panels keep their compact metrics -->
  <Style Selector="TextBox.field, TextBox.dialogInput, ComboBox.field">
    <Setter Property="MinHeight" Value="{DynamicResource AppFieldMinHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppCornerSmall}" />
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.InputBackground}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.InputForeground}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.InputBorder}}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.field, TextBox.dialogInput">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="WatermarkForeground" Value="{DynamicResource {x:Static rp:ThemeDictionary.DescriptionForeground}}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.EditorSelectionBackground}}" />
  </Style>
  <Style Selector="ComboBox.field">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.field:pointerover, TextBox.dialogInput:pointerover, ComboBox.field:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListFocusOutline}}" />
  </Style>
  <Style Selector="TextBox.field:focus, TextBox.dialogInput:focus, ComboBox.field:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.FocusBorder}}" />
  </Style>
  <Style Selector="TextBox.field:disabled, TextBox.dialogInput:disabled, ComboBox.field:disabled">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.DisabledForeground}}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.primary, Button.dialogButton">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonBackground}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonForeground}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonBorder}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppCornerSmall}" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.dialogButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonHoverBackground}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonHoverBackground}}" />
  </Style>
  <Style Selector="Button.primary:pointerover, Button.dialogButton:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonForeground}}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.dialogButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonHoverBackground}}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonSecondaryBackground}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonSecondaryForeground}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonSecondaryBorder}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppCornerSmall}" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonSecondaryHoverBackground}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListFocusOutline}}" />
  </Style>
  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonSecondaryForeground}}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ButtonSecondaryHoverBackground}}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ErrorForeground}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.ErrorForeground}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppCornerSmall}" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListHoverBackground}}" />
  </Style>
  <Style Selector="Button.primary:disabled, Button.dialogButton:disabled, Button.secondary:disabled, Button.danger:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.infoCallout">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.EditorWidgetBackground}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.WidgetBorder}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppCornerMedium}" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.PanelBorder}}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- Splitters -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListHoverBackground}}" />
  </Style>

  <!-- Popups -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.MenuBackground}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.MenuForeground}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.MenuBorder}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppCornerSmall}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.MenuBackground}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.MenuBorder}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppCornerMedium}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.MenuForeground}}" />
    <Setter Property="MinHeight" Value="{DynamicResource AppListRowHeight}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppCornerSmall}" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.MenuSeparatorBackground}}" />
  </Style>

  <!-- Status and progress -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListFocusOutline}}" />
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ProgressBarBackground}}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListFocusOutline}}" />
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.Foreground}}" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <!-- Toolbar, tree and validation styles formerly in App.axaml -->

  <Style Selector="TextBlock.Title">
    <Setter Property="FontSize" Value="16" />
  </Style>

  <!-- Flat icon buttons used in toolbars; hover/active colors follow the VS Code theme -->
  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool Image, ToggleButton.tool Image">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ToolbarHoverBackground}}" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ToolbarActiveBackground}}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.InputOptionActiveBackground}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.InputOptionActiveBorder}}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.tool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.InputOptionActiveBackground}}" />
  </Style>
  <Style Selector="Button.tool:disabled, ToggleButton.tool:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Vertical separator between toolbar button groups -->
  <Style Selector="Separator.toolbar">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="5 0" />
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.PanelBorder}}" />
  </Style>

  <!-- Map tree item selection/hover onto the VS Code list.* theme colors instead of the Fluent accent.
       :focus-within reproduces VS Code's active (tree focused) vs. inactive (editor focused) selection. -->
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="{DynamicResource AppListRowHeight}" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListHoverBackground}}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListInactiveSelectionBackground}}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TreeViewItem:selected">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListInactiveSelectionBackground}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListInactiveSelectionForeground}}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListInactiveSelectionBackground}}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot > ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListInactiveSelectionForeground}}" />
  </Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover > ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListHoverForeground}}" />
  </Style>
  <Style Selector="TreeView:focus-within TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListActiveSelectionBackground}}" />
  </Style>
  <Style Selector="TreeView:focus-within TreeViewItem:selected">
    <Setter Property="Background" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListActiveSelectionBackground}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListActiveSelectionForeground}}" />
  </Style>
  <Style Selector="TreeView:focus-within TreeViewItem:selected /template/ Border#PART_LayoutRoot > ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static rp:ThemeDictionary.ListActiveSelectionForeground}}" />
  </Style>

  <Style Selector="DataValidationErrors">
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel LastChildFill="True">
          <ContentControl DockPanel.Dock="Right"
                          x:DataType="DataValidationErrors"
                          ContentTemplate="{TemplateBinding ErrorTemplate}"
                          DataContext="{TemplateBinding Owner}"
                          Content="{Binding (DataValidationErrors.Errors)}"
                          IsVisible="{Binding (DataValidationErrors.HasErrors)}"/>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
    <Setter Property="ErrorTemplate">
      <DataTemplate x:CompileBindings="false">
        <Canvas Width="14" Height="14" Margin="4 0 1 0"
                Background="Transparent">
          <Canvas.Styles>
            <Style Selector="ToolTip">
              <Setter Property="BorderBrush" Value="{DynamicResource {x:Static rp:ThemeDictionary.ErrorForeground}}"/>
            </Style>
          </Canvas.Styles>
          <ToolTip.Tip>
            <ItemsControl ItemsSource="{Binding}"/>
          </ToolTip.Tip>
          <Path Data="M14,7 A7,7 0 0,0 0,7 M0,7 A7,7 0 1,0 14,7 M7,3l0,5 M7,9l0,2"
                Stroke="{DynamicResource {x:Static rp:ThemeDictionary.ErrorForeground}}"
                StrokeThickness="2"/>
        </Canvas>
      </DataTemplate>
    </Setter>
  </Style>
</Styles>
