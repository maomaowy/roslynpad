<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RoslynPad.App"
             xmlns:rp="clr-namespace:RoslynPad;assembly=RoslynPad"
             xmlns:codeAnalysis="clr-namespace:Microsoft.CodeAnalysis;assembly=Microsoft.CodeAnalysis"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             Name="RoslynPad">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="L_App_SettingsMenu" Click="OnSettingsClick"
                      Gesture="Meta+OemComma" />
    </NativeMenu>
  </NativeMenu.Menu>
  <Application.Styles>
    <FluentTheme />
    <DockFluentTheme />
    <StyleInclude Source="/DockTheme.axaml" />
    <StyleInclude Source="/ScrollBarTheme.axaml" />
    <StyleInclude Source="/Styles/ThemeStyles.axaml" />
    <dialogHostAvalonia:DialogHostStyles />
  </Application.Styles>
  <Application.DataTemplates>

    <DataTemplate DataType="Drawing">
      <Image Source="{Binding Mode=OneTime}" />
    </DataTemplate>

    <DataTemplate DataType="codeAnalysis:Diagnostic">
      <TextBlock Text="{Binding Descriptor.Title, Mode=OneTime}" />
    </DataTemplate>
  </Application.DataTemplates>
</Application>