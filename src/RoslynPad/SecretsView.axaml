<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:RoslynPad.UI"
             xmlns:local="clr-namespace:RoslynPad;assembly=RoslynPad"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="500"
             x:Class="RoslynPad.SecretsView"
             x:DataType="ui:SecretsViewModel">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Usage -->
        <Border Grid.Row="0"
                Classes="infoCallout"
                Margin="0,0,0,12">
            <SelectableTextBlock TextWrapping="Wrap">
                <Run Text="{DynamicResource L_Secrets_UsageBefore}" /><Run Text="RoslynPad.Runtime.Secrets" FontFamily="Consolas,Menlo,monospace" FontWeight="SemiBold" /><Run Text="{DynamicResource L_Secrets_UsageAfterPackage}" /><Run Text="SecretManager.Default.Get(&quot;secret-name&quot;)" FontFamily="Consolas,Menlo,monospace" FontWeight="SemiBold" /><Run Text="{DynamicResource L_Secrets_UsageEnd}" />
            </SelectableTextBlock>
        </Border>

        <!-- Directory -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12" Spacing="4">
            <TextBlock Text="{DynamicResource L_Secrets_DirectoryLabel}"
                       Classes="sectionTitle" />
            <TextBox Classes="field"
                     Text="{Binding Directory, Mode=OneWay}"
                     IsReadOnly="True" />
        </StackPanel>

        <!-- Add Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Classes="primary"
                    Content="{DynamicResource L_Secrets_AddButton}"
                    Command="{Binding AddCommand}" />
        </StackPanel>

        <!-- Error -->
        <TextBlock Grid.Row="3"
                   Text="{Binding Error}"
                   Classes="errorText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Secrets List -->
        <Panel Grid.Row="4">
            <ScrollViewer IsVisible="{Binding HasSecrets}">
                <ItemsControl Name="SecretsItemsControl" ItemsSource="{Binding Secrets}"
                              Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:SecretItemViewModel}">
                            <Border BorderBrush="{DynamicResource {x:Static local:ThemeDictionary.PanelBorder}}"
                                    BorderThickness="0,0,0,1"
                                    Padding="6,8">
                                <Panel>
                                    <!-- Editing row -->
                                    <Grid ColumnDefinitions="*,*,Auto,Auto"
                                          IsVisible="{Binding IsEditing}">
                                        <TextBox Grid.Column="0"
                                                 Classes="field"
                                                 Text="{Binding EditName}"
                                                 PlaceholderText="{DynamicResource L_Secrets_NameLabel}"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center" />

                                        <TextBox Grid.Column="1"
                                                 Classes="field"
                                                 Text="{Binding EditValue}"
                                                 PlaceholderText="{DynamicResource L_Secrets_ValueLabel}"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center" />

                                        <Button Grid.Column="2"
                                                Classes="secondary"
                                                Content="{DynamicResource L_Secrets_SaveButton}"
                                                Command="{Binding #SecretsItemsControl.((ui:SecretsViewModel)DataContext).SaveNewSecretCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />

                                        <Button Grid.Column="3"
                                                Classes="secondary"
                                                Content="{DynamicResource L_Secrets_CancelButton}"
                                                Command="{Binding #SecretsItemsControl.((ui:SecretsViewModel)DataContext).CancelNewSecretCommand}"
                                                CommandParameter="{Binding}"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Display row -->
                                    <Grid IsVisible="{Binding !IsEditing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SecretName" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0" />

                                        <!-- Value TextBox: read-only dots when hidden, editable when revealed -->
                                        <TextBox Grid.Column="1"
                                                 Classes="field"
                                                 Text="••••••••"
                                                 IsReadOnly="True"
                                                 CopyingToClipboard="OnCopyingToClipboard"
                                                 IsVisible="{Binding !IsRevealed}"
                                                 VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Classes="field"
                                                 Text="{Binding EditableValue}"
                                                 IsVisible="{Binding IsRevealed}"
                                                 VerticalAlignment="Center" />

                                        <ToggleButton Grid.Column="2"
                                                      Classes="tool"
                                                      IsChecked="{Binding IsRevealed}"
                                                      Margin="4,0"
                                                      AutomationProperties.Name="{DynamicResource L_Tooltip_RevealSecret}"
                                                      ToolTip.Tip="{DynamicResource L_Tooltip_RevealSecret}"
                                                      VerticalAlignment="Center">
                                            <Panel>
                                                <Image Source="{DynamicResource Visible}" Width="16" Height="16"
                                                       IsVisible="{Binding !IsRevealed}" />
                                                <Image Source="{DynamicResource VisibleFilled}" Width="16" Height="16"
                                                       IsVisible="{Binding IsRevealed}" />
                                            </Panel>
                                        </ToggleButton>

                                        <!-- Save button: only visible when revealed -->
                                        <Button Grid.Column="3"
                                                Classes="tool"
                                                Command="{Binding #SecretsItemsControl.((ui:SecretsViewModel)DataContext).SaveValueCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsRevealed}"
                                                AutomationProperties.Name="{DynamicResource L_Tooltip_SaveSecret}"
                                                ToolTip.Tip="{DynamicResource L_Tooltip_SaveSecret}"
                                                VerticalAlignment="Center">
                                            <Image Source="{DynamicResource Save}" Width="16" Height="16" />
                                        </Button>

                                        <Button Grid.Column="4"
                                                Classes="tool"
                                                Command="{Binding #SecretsItemsControl.((ui:SecretsViewModel)DataContext).CopyCommand}"
                                                CommandParameter="{Binding}"
                                                Margin="4,0"
                                                AutomationProperties.Name="{DynamicResource L_Tooltip_CopySecret}"
                                                ToolTip.Tip="{DynamicResource L_Tooltip_CopySecret}"
                                                VerticalAlignment="Center">
                                            <Image Source="{DynamicResource Copy}" Width="16" Height="16" />
                                        </Button>

                                        <Button Grid.Column="5"
                                                Classes="tool"
                                                Command="{Binding #SecretsItemsControl.((ui:SecretsViewModel)DataContext).RemoveCommand}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{DynamicResource L_Tooltip_DeleteSecret}"
                                                ToolTip.Tip="{DynamicResource L_Tooltip_DeleteSecret}"
                                                VerticalAlignment="Center">
                                            <Image Source="{DynamicResource Delete}" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Classes="emptyState"
                       Text="{DynamicResource L_Secrets_Empty}"
                       IsVisible="{Binding !HasSecrets}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="360"
                       IsHitTestVisible="False" />
        </Panel>
    </Grid>
</UserControl>
